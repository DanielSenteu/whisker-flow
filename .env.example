# Copy to .env (never commit .env)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Phone calls (Twilio). The pack can only call saved contacts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=      # your Twilio number, e.g. +16045550100
DEMO_PHONE_NUMBER=       # your own phone: what "call me" rings, e.g. +16045550199
# PHONE_CONTACTS={"sam":"+16045550123"}
